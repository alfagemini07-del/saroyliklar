ENVIRONMENT=development
DEBUG=true
PUBLIC_BASE_URL=http://localhost:8000
BOT_TOKEN=
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=replace-with-a-random-secret
ADMIN_IDS=123456789
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SECRET_KEY=replace-with-a-long-random-secret

# Supabase Connect -> Session pooler (port 5432), with +asyncpg added.
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DB_SSL=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

SUPABASE_URL=https://PROJECT_REF.supabase.co
# Use either SUPABASE_SECRET_KEY (new key) or SUPABASE_SERVICE_ROLE_KEY (legacy key).
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=saroyliklar-media
MAX_UPLOAD_MB=20

GEMINI_API_KEY=

# Only for local WebApp testing outside Telegram. Keep 0 on Render.
DEV_TELEGRAM_ID=0
